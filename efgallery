# main program
@ARGV = map { decode($_) } @ARGV;
my ($rc, @ARGS) = GetOptions(
  'help|h' => sub { print_help(0); },
  'version' => sub { print "$0 $VERSION\n"; exit 0; },
  'c=s' => sub { @captions = @{ parse_captions($_[0], $_[1]) }; },
  'd' => sub { $offerzip = 0; },
  'f' => sub { $facedetect = 1; },
  'i' => sub { $include = 1; },
  'j=i' => sub { $workers = parse_int($_[0], $_[1], 1, undef); },
  'o' => sub { $orient = 0; },
  'k' => sub { $optimize = 0; },
  'n=s' => \$name,
  'p' => sub { $fullpano = 0; },
  'r' => sub { $chronological = -1; },
  't' => sub { $chronological = 0; },
  'u' => sub { $updating = 1; },
  'v' => sub { $verbose++; },
  'no-blur' => sub { $do_blur = 0; },
  'no-sRGB' => sub { $sRGB = 0; },
  'max-full=s' => sub { @maxfull = parse_wh(@_); },
  'max-thumb=s' => sub { @maxthumb = parse_wh(@_); },
  'min-thumb=s' => sub { @minthumb = parse_wh(@_); },
  'quality=i' => sub { $imgquality = parse_int($_[0], $_[1], 0, 100); },
  'index=s' => \$indexUrl,
  'title=s' => \$galleryTitle,
  'description=s' => \$galleryDescription,
  'url=s' => \$galleryUrl,
  'link-orig:s' => sub { $copy_method_orig = parse_copy_method($_[0], $_[1]); },
  'link-view:s' => sub { $copy_method_view = parse_copy_method($_[0], $_[1]); },
  'viewdir:s' => \$viewdir,
  'startslideshow' => sub { $startslideshow = 'yes'; },
);

print_help(2) unless $rc && ( (@ARGV == 2) || ((@ARGV == 1) && $updating) );

fatal "no such directory $viewdir; try --viewdir option\n"
  unless -d $viewdir;

if (($galleryTitle || $galleryDescription || $galleryUrl)
    && !($galleryTitle && $galleryDescription && $galleryUrl)) {
  fatal "All three are required: --title, --description, and --url";
}

# only -u may operate on the "input directory" (i.e., for image removals)
($dir, $out) = @ARGV;
$absDir = canonpath(rel2abs($dir)) . '/';
$json_file = catfile($absDir, 'data.json');
if ($out) {
  $absOut = canonpath(rel2abs($out));
  $json_file = catfile($absOut, 'data.json');
  if (!-d $absDir) {
    fatal "input directory '$absDir' does not exist";
  } elsif ($absDir eq $absOut) {
    fatal "input and output directory are the same" unless $updating;
  } elsif (substr($absOut, 0, length($absDir)) eq $absDir) {
    fatal "output directory cannot be a sub-directory of input directory";
  } elsif (!-d $absOut) {
    if ($updating) {
      fatal "Directory '$absOut' missing, cannot update" unless is_a_gallery($absOut);
    }
  } elsif (!is_a_gallery($absOut)) {
    fatal "output dir '$absOut' exists, but doesn't look like an $me album";
  }
} else {
  fatal "Use -u option if you want to update image removals"
    unless $updating;
  fatal "input directory '$absDir' does not exist"
    unless -d $absDir;
  $absOut = $absDir;
}

# check for required commands
for (qw(cp ln mv touch)) {
  fatal "Command '$_' missing" unless cmd_exists($_);
}
fatal 'Missing magick executable (from ImageMagick)'
  unless cmd_exists('magick');
if ($offerzip) {
  if (!cmd_exists('7za')) {
    $p7zip = 0;
    cmd_exists('zip') || fatal "Missing '7z' or 'zip' command; try -d option"
  }
}
if (!cmd_exists('jpegoptim')) {
  $optimize_jpg = 0;
  warn "Command jpegoptim missing - will not optimize JPEG images (see also -k option)\n"
    if $verbose;
}
if (!cmd_exists('pngcrush')) {
  $optimize_png = 0;
  warn "Command pngcrush missing - will not optimize PNG images (see also -k option)\n"
    if $verbose;
}
fatal "Missing facedetect (see $facedetect_url); cannot use -f option"
  if $facedetect && !cmd_exists('facedetect');
fatal 'Missing tificc executable (from lcms2 library); try --no-sRGB option'
  if $sRGB && !cmd_exists('tificc');
my $tificccmd = 'tificc';
my $exiftrancmd;
while($orient)
{
  $exiftrancmd = "exiftran -aip" if cmd_exists('exiftran');
  last if $exiftrancmd;
  $exiftrancmd = "exifautotran" if cmd_exists('exifautotran');
  fatal 'Missing exiftran or exifautotran executable for JPEG autorotation; try -o option'
    unless $exiftrancmd;
}

if ($updating) {
  # if the directory already exists, don't fiddle with it unless it has a data.json file
  fatal "Output directory '$absOut' doesn't contain '$json_file'; cannot continue"
    unless -f $json_file;
  fatal "File '$json_file' not writable; cannot update album"
    unless -w _;
}

$zipfile = catfile($absOut, $albumzip);
if ($updating && $offerzip) {
  if (! -f $zipfile) {
    warn "Original zip file '$zipfile' missing: will not create one when updating (see -d option)\n";
    $offerzip = 0;
  }
  if (! -w _) {
    warn "Original zip file '$zipfile' not writable: will not create one when updating (see -d option)\n";
    $offerzip = 0;
  }
}

# get a list of available files with desired extensions
my @files;
find(
  {
    no_chdir => 1,
    wanted => sub {
      my $file = decode($_);
      return unless -f $file;
      my ($base, undef, $suffix) = fileparse($file, qr/\.[^.]*$/);
      return if (length($suffix) < 2 || $base =~ /^\./);
      $suffix = lc(substr($suffix, 1));
      push(@files, $file) if exists $extensions{$suffix};
    }
  }, encode($absDir)
) unless $absOut eq $absDir;
@files = sort @files;
fatal "No image files found in '$absDir'" unless @files || $updating;

# derived arguments
my $backblur = int(($minthumb[0] + $minthumb[1]) / 2 * 0.1);
my @backsize = (int($minthumb[0] * 4), int($minthumb[1] * 3));

# updating reads data from the original JSON file and rewrites it later
if (-f $json_file) {
  fatal "A non-writable '$json_file' was found; cannot continue" unless -w _;
  unless ($updating) {
    warn "Found $json_file; updating ...\n";
    $updating++;
  }
  $odata = read_json($json_file);
  warn Data::Dumper->Dump([$odata], ['old_json_data']), "\n"
    if $verbose > 2;
  for (@{$odata->{data}}) {
    next unless exists $_->{$alg};
    next unless exists $_->{img};
    $ofiles->{$_->{$alg}} = $_->{img}->[0];
    warn "SHA $_->{img}->[0]: $_->{$alg}\n" if $verbose > 1;
  }
  my @newfiles = ();
  for (@files) {
    fatal("Can't read file '$_'") unless -r $_;
    $sha->addfile($_);
    my $d = $sha->hexdigest();
    $sha->reset();
    warn "SHA $_: $d\n" if $verbose > 1;
    push @newfiles, $_ unless $ofiles->{$d};
  }
  if (@newfiles) {
    printf "Updating: %d of total %d found image files are new\n",
      scalar @newfiles, scalar @files;
  } else {
    printf "Updating: None of the %d found image files are new\n",
      scalar @files if @files;
  }
  @files = @newfiles;
  $name = $odata->{name} if $odata->{name} && !$name;
} else {
  # cleanup target paths
  fatal "No $json_file file found, cannot update" if $updating;
  for ( qw(thumbs blurs imgs files) ) {
    my $d = catfile($absOut, $_);
    remove_tree($d);
    make_path($d, {mode => $dirmode});
    set_dir_mode($d);
  }
}

# now that $absOut definitely exists, do all work there
make_path($absOut, {mode => $dirmode}) unless -d $absOut;
set_dir_mode($absOut);
chdir($absOut) || fatal "Failed to 'cd $absOut' for $me album creation: $!";

# disable sub-process parallelism when threading ourselves
$workers = @files if $workers > @files;
if ($workers) {
  $ENV{MAGICK_THREAD_LIMIT} = 1;
  $ENV{OMP_NUM_THREADS} = 1;
}

# 1st pass: extract/prepare input file data
sub analyze_file
{
  my ($file) = @_;
  my ($base, $absDir, $suffix) = fileparse(decode($file), qr/\.[^.]*$/);
  $suffix = lc(substr($suffix, 1));

  progress::status("$base.$suffix");

  my $props = ImageInfo($file, {PrintConv => 0, Sort => 'File'});
  return unless defined $props && exists $props->{FileType}
                               && exists $filetypes{$props->{FileType}};

  # sanitize file name
  my $sane = $base;
  $sane =~ s/[^\w\-]/_/gu;
  my $root = $sane;

  # create a new file, try with names_#.jpg until we find the first one free
  for (my $c = 0;; $c++) {
    my $tmp = catfile(catfile($absOut, 'imgs'), "$root.$ext");
    if ( sysopen(my $fd, $tmp, O_WRONLY|O_CREAT|O_EXCL, $filemode) ) {
      close($fd);
      last;
    }
    $root = sprintf "%s_%d", $sane, $c;
  }

  $props->{file} = $file;
  $props->{root} = $root;
  $props->{suffix} = $suffix;

  # try to get original image size by iterating to the last duplicated tag
  $props->{OrigImageWidth} = $props->{ExifImageWidth} || undef;
  $props->{OrigImageHeight} = $props->{ExifImageHeight} || undef;
  for(my $n = 1; exists $props->{"ExifImageWidth ($n)"}; $n++) {
    $props->{OrigImageWidth} = $props->{"ExifImageWidth ($n)"};
    $props->{OrigImageHeight} = $props->{"ExifImageHeight ($n)"};
  }

  # extract caption
  for my $m (@captions) {
    if ($m eq 'cmt') {
      if ($props->{Comment}) {
        my $cmt = Encode::decode_utf8($props->{Comment});
        $props->{caption} = cap_from_str($cmt);
        last;
      }
    } elsif ($m eq 'txt') {
      my $txt = catfile($absDir, $base . '.txt');
      if (-f $txt) {
        $props->{caption} = cap_from_str(slurp($txt));
        last;
      }
    } elsif ($m eq 'exif') {
      if ($props->{Title} || $props->{Description}) {
        $props->{caption} = cap_from_props($props);
        last;
      }
    } elsif ($m eq 'xmp') {
      my $xmp = ImageInfo("$file.xmp", {PrintConv => 0, Sort => 'File'});
      if (defined($xmp) && ($xmp->{Title} || $xmp->{Description})) {
        $props->{caption} = cap_from_props($xmp);
        last;
      }
    } else {
      fatal "Encountered unknown caption method '$m'";
    }
  }

  return $props;
}

# get image properties of files with image extensions
if (@files) {
  warn sprintf "Found %d candidate image files\n", scalar @files
    if $verbose;
  warn map { "  $_\n" } @files
    if @files && $verbose > 1;
  progress::init('Image file inspection', scalar @files);
  $aprops = run_in_parallel('analyze', \&analyze_file, \@files);
  dump_properties($aprops) if $verbose > 2;
  # remove any files that failed analysis
  my @nf = ();
  my @na = ();
  my $n = 0;
  for (@files) {
    if ( defined $aprops->[$n] ) {
      push @nf, $_;
      push @na, $aprops->[$n];
    } else {
      warn "Image '$_' failed analysis - skipping\n";
    }
    $n++;
  }
  progress::done(sprintf '- will now process %d image files', scalar @nf);
  @files = @nf;
  $aprops = \@na;
}

if ($updating) {
  warn "No new image files to process\n" unless @files;
  # but maybe some files were removed and data.json needs updating ...
  my %o = map { $_ => 1 } values %$ofiles;
  delete $o{catfile('imgs', $_)} for @{current_imgs(catfile($absOut, 'imgs'))};
  # these files will need to be removed from zipfile further below
  my @d = map { (File::Spec->splitpath($_))[2] } keys %o;
  if (@d) {
    my $n = scalar @d;
    $n == 1 ?  warn "One image file was removed; updating gallery\n" :
      warn sprintf "%d image files were removed; updating gallery\n", $n;
    # redefined aref $odata->{data} leaving out the deleted images
    my @ndata = ();
    for ( @{$odata->{data}} ) {
      if ( (exists $_->{img}) && (exists $o{$_->{img}->[0]}) ) {
        warn "Image file '$_->{img}->[0]' was removed\n" if $verbose;
        push @deleted, $_->{file} || $_->{orig};
        for ($_->{blur}, $_->{thumb}->[0], $_->{file} || $_->{orig}) {
          next unless -f $_;
          unlink $_ || fatal "Failed to remove '$_': $!";
          warn "Removed '$_'\n" if $verbose > 1;
        }
        next;
      }
      push @ndata, $_;
    }
    $odata->{data} = \@ndata;
  }
} else {
  warn "No image files found for processing\n" unless @files;
}

# gather dates and megapixel sizes of image files
my $amp = 0;
my $ostamp = 0;
for my $props (@$aprops) {
  # file timestamp
  my $idate = $props->{DateTimeOriginal} || $props->{DateTime} || '';
  $idate =~ s/^\s+|\s+$//g;
  my $t = Time::Piece->strptime($idate, "%Y:%m:%d %H:%M:%S");
  if ($t && $t->epoch()) {
    $props->{date} = $t->strftime("%Y-%m-%d %H:%M");
    $props->{stamp} = $ostamp = $t->epoch();
  } else {
    # no date available, cheat by using the previous timestamp
    $props->{stamp} = $ostamp = $ostamp + 1;
  }
  # megapixels and average thereof
  $props->{mp} = ($props->{ImageWidth} * $props->{ImageHeight} / 1e6);
  $amp += $props->{mp};
}
$amp /= @files if @files;

# 2nd pass: produce output files
sub process_img
{
  my %props = %{$_[0]};
  my $root = $props{root};
  my $suffix = $props{suffix};
  my $file = $props{file};

  # derived file names
  my $ffile = catfile('files', "$root.$suffix");
  my $fbase = "$root.$ext";
  my $fimg = catfile('imgs', $fbase);
  my $fthumb = catfile('thumbs', $fbase);
  my $fblur = catfile('blurs', $fbase);

  my $absFout = catfile($absOut, $ffile);
  my $absFtmp = catfile($absOut, "$ffile.tmp");

  progress::status($fbase);

  # copy source image, optimize unless suppressed, set mode and file timestamp
  return if copy_source_file($file, $absFout);
  if ($optimize || $orient) {
    if ($orient && $props{FileType} eq "JPEG" && ($props{Orientation} // 0)) {
      return if sys("$exiftrancmd '$absFout' 2>&1");
      if (($props{Orientation} // 0) > 4) {
        ($props{ImageWidth}, $props{ImageHeight})
          = ($props{ImageHeight}, $props{ImageWidth});
      }
    }
    if ($optimize_jpg && $props{FileType} eq "JPEG") {
      return if sys('jpegoptim', '-q', $absFout);
    } elsif ($optimize_png && $props{FileType} eq "PNG") {
      return if sys('pngcrush', '-q', $absFout, $absFtmp);
      rename($absFtmp, $absFout);
    }
  }
  set_file_mode($absFout);
  sys('touch', '-r', $file, $absFout); # ignore errors

  # intermediate sRGB colorspace conversion
  if ( !$sRGB || !defined($props{ProfileID})
              || ($props{ColorSpace} // 65535) == 1
              || ($props{DeviceModel} // '') eq 'sRGB') {
    $absFtmp = $absFout;
  } else {
    return if sys('magick', '-quiet', $absFout, '-compress', 'LZW', '-type', 'truecolor', "tiff:$absFtmp");
    return if sys($tificccmd, '-t0', $absFtmp, "$absFtmp.tmp");
    rename("$absFtmp.tmp", $absFtmp);
  }

  # generate main image
  my @sfile = ($props{ImageWidth}, $props{ImageHeight});
  my @cmd = ('magick', '-quiet', $absFtmp, '-gamma', '0.454545',
          '-geometry', "$maxfull[0]x$maxfull[1]>",
          '-print', '%w\n%h', '-gamma', '2.2', '+profile', '!icc,*',
          '-quality', $imgquality, catfile($absOut, $fimg)
  );
  my ($rc, $simg) = sys_with_output(@cmd);
  return if $rc;
  set_file_mode(catfile($absOut, $fimg));

  # face/center detection
  my @center = (0.5, 0.5);
  if ($facedetect) {
    my @cmd = ('facedetect', '--best', '--center', catfile($absOut, $fimg));
    my ($rc, $o) = sys_with_output(@cmd);
    return if $rc;
    for (@$o) {
      if (my @tmp = /(\d+) (\d+) (\d+) (\d+)/) {
	@center = ($tmp[0] / $simg->[0], $tmp[1] / $simg->[1]);
	last;
      }
    }
  }

  # thumbnail size
  my $thumbrt;
  if ($sfile[0] / $sfile[1] < $minthumb[0] / $minthumb[1]) {
    $thumbrt = $minthumb[0] / $sfile[0];
  } else {
    $thumbrt = $minthumb[1] / $sfile[1];
  }
  my @sthumb = (max(int($sfile[0] * $thumbrt + 0.5), $minthumb[0]),
                max(int($sfile[1] * $thumbrt + 0.5), $minthumb[1]));
  my @mthumb = (min($maxthumb[0], $sthumb[0]),
                min($maxthumb[1], $sthumb[1]));

  # cropping window
  my $dx = $sthumb[0] - $mthumb[0];
  my $cx = pmin($dx, int($center[0] * $sthumb[0] - $sthumb[0] / 2 + $dx / 2));
  my $dy = $sthumb[1] - $mthumb[1];
  my $cy = pmin($dy, int($center[1] * $sthumb[1] - $sthumb[1] / 2 + $dy / 2));

  return if sys('magick', $absFtmp,
                ($verbose > 1 ? () : '-quiet'),
                '-gamma', '0.454545',
                '-resize', "$sthumb[0]x$sthumb[1]!",
                '-gravity', 'NorthWest',
                '-crop', "$mthumb[0]x$mthumb[1]+$cx+$cy",
                '-gamma', '2.2',
                '-quality', $imgquality,
                '+profile', '!icc,*',
                $fthumb,
              );
  set_file_mode(catfile($absOut, $fthumb));

  if ($do_blur) {
    return if sys('magick', $fthumb,
                  ($verbose > 1 ? () : '-quiet'),
                  '-virtual-pixel', 'Mirror',
                  '-gaussian-blur', "0x$backblur",
                  '-scale', "$backsize[0]x$backsize[1]",
                  '-quality', '90',
                  $fblur,
                );
    set_file_mode(catfile($absOut, $fblur));
  }

  my %fdata;
  $fdata{props} = \%props;
  $fdata{img} = [$fimg, [map { int } @$simg]];
  $fdata{file} = [$ffile, [map { int } @sfile]];
  $fdata{blur} = $fblur if $do_blur;

  # avoid storing duplicate information
  my @tdata = ($fthumb, [map { int } @mthumb]);
  if ($sthumb[0] != $mthumb[0] || $sthumb[1] != $mthumb[1]) {
    push(@tdata, [map { int } @sthumb], [map { int } $cx, $cy]);
  }
  $fdata{thumb} = \@tdata;

  # truncate some floats
  $center[0] = int($center[0] * 1000);
  $center[1] = int($center[1] * 1000);
  if (abs($center[0] - 500) > 1 || abs($center[0] - 500) > 1) {
    $fdata{center} = \@center;
  }

  # remove temporary files
  unlink($absFtmp) if $absFtmp ne $absFout;

  return \%fdata;
}

# create thumbnails, blurs, and do face detection where required
if (@$aprops) {
  warn map { "  $_\n" } map { $_->{file} } @$aprops
    if $verbose > 1;
  my $msg = sprintf "Processing of %d image files", scalar @$aprops;
  progress::init($msg, scalar(@$aprops));
  $adata = run_in_parallel('process', \&process_img, $aprops);
  progress::done();
  dump_properties($adata) if $verbose > 2;
}

# create or update the album zip file
if ($offerzip) {
  if ($adata && @$adata) {
    my @f = ();
    chdir('files') || fatal "Failed to cd to files subdirectory for zipping";
    for (@$adata) {
      # files that failed analysis are undefined in @$adata
      next unless $_;
      my $f = (splitpath($_->{file}[0]))[2];
      if ( $f && -f $f && -r _) {
        push @f, $f;
      } else {
        warn "No file '$f' in files subdir - not adding to $zipfile\n";
      }
    }
    warn "Adding following images to $albumzip:\n",
      map { sprintf "  $_\n" } @f if $verbose > 1;
    my $rc;
    if ($p7zip) {
      my @v = $verbose > 2 ? ('-bb3', '-bt')
            : $verbose > 1 ? ('-bb2', '-bt')
            : $verbose ?     ('-bb1', '-bt')
            :                ('-bb0');
      my $mt = $workers ? "-mmt=$workers" : '';
      $rc = sys('7za', '-tzip', @v, $mt, 'a', '--', $zipfile, @f);
    } else {
      my $v = $verbose ? '-v' : '-q';
      $rc = sys('zip', '-q9j', $v, $zipfile, @f);
    }
    fatal "Failed to create $albumzip (rc=$rc)" if $rc;
    set_file_mode($zipfile);
    warn sprintf "Updated %s with %d image files\n", $zipfile, scalar @f;
    chdir($absOut) || fatal "Failed to cd to $absOut after zipping: $!";
  }
} else {
  unlink $zipfile;
}
if (@deleted && -f $zipfile) {
  # @deleted refers to file/IMAGE.jpg but zipfile simply calls it IMAGE.jpg
  my @del = map { (splitpath($_))[2] } @deleted;
  warn "Deleting - if present - following files from $albumzip:\n",
        map { sprintf "  $_\n" } @del if $verbose > 1;
  if ($p7zip) {
    my @v = $verbose > 2 ? ('-bb3', '-bt')
          : $verbose > 1 ? ('-bb2', '-bt')
          : $verbose ?     ('-bb1', '-bt')
          : ();
    $rc = sys('7za', '-tzip', @v, 'd', '--', $zipfile, @del);
  } else {
    my $v = $verbose ? '-v' : '-q';
    $rc = sys('zip', '-q9j', '-d', $zipfile, @del);
  }
  fatal "Failed to update $albumzip (rc=$rc)" if $rc;
  warn sprintf "Removed %d image files from %s\n", scalar @del, $zipfile;
}

# prepare and write out the new data.json
my %json = (
  data => [],
  thumb => { min => \@minthumb, max => \@maxthumb },
);
$json{blur} = \@backsize if $do_blur;
for my $fdata (@$adata) {
  next unless $fdata;
  my %data;
  for ( qw(img thumb blur center) ) {
    $data{$_} = $fdata->{$_} if defined $fdata->{$_};
  }
  for ( qw(date stamp caption) ) {
    $data{$_} = $fdata->{props}{$_} if defined $fdata->{props}{$_};
  }
  my $file = $fdata->{file}[0];
  fatal("No such file '$file'") unless -f $file;
  fatal("Can't read file '$file'") unless -r _;
  $sha->addfile($file);
  my $d = $sha->hexdigest();
  $sha->reset();
  $data{$alg} = $d;
  $data{file} = $file;
  # remove superfluous raw files
  my $keep = $include;
  unless ($keep || !$fullpano) {
    my ($x, $y) = @{$fdata->{file}[1]};
    my $mp = ($x * $y / 1e6);
    # see if the source file is just a crop of the original
    my $ox = $fdata->{props}{OrigImageWidth} // 0;
    my $oy = $fdata->{props}{OrigImageHeight} // 0;
    my $omp = ($ox * $oy / 1e6);
    $keep = 1 if ($mp >= $omp) && ($mp > $amp) && (abs($x/$y) >= $panort);
  }
  unless ($keep) {
    unlink($file);
    warn "Deleted raw file '$file' (see -i and -k options)\n" if $verbose > 1;
  }
  push(@{$json{data}}, \%data)
    unless (exists $ofiles->{$d}) && ($ofiles->{$d} = $data{stamp});
}
write_json('data.json', \%json, $odata->{data});

# remove the files directory when empty
rmdir('files');

# (re-)setup copy/link of view subdirectory
my $vdir = 'view';
remove_tree($vdir) if $updating;
unless (-d $vdir) {
  my $rc;
  if ($copy_method_view eq 'syml') {
    $rc = sys('ln', '-s', $viewdir, '.');
   } else {
    $rc = sys('cp', '-LR', $viewdir, '.');
    # the cp -LR copy inherits the modes of the installed view tree;
    # normalize them so the gallery is world-readable
    find({
      no_chdir => 1,
      wanted => sub {
        chmod((-d $_ ? $dirmode : $filemode), $_);
      }
    }, $vdir) unless $rc;
  }
  fatal "Failed to cp ($copy_method_view) $viewdir" if $rc;
}
# craft the index.html contents from the actual data.json file
my $html = qq{\n    <div id="photos" } .
           qq{itemscope itemtype="http://schema.org/ImageGallery">\n};
$html .= qq{\t<h1 itemprop="name">$galleryTitle</h1>\n}
    if $galleryTitle;
$html .= qq{\t<p itemprop="description">$galleryDescription</p>\n}
    if $galleryDescription;
$html .= qq{\t<div id="wrapper">};
# enumerate the images for noscript
my $id = 0;
$adata = read_json($json_file);
for (@{$adata->{data}}) {
  my $f = $_->{img}[0];
  my $t = $_->{thumb}[0];
  # find caption and description for alt and title
  my ($x, $y);
  if ((exists $_->{caption}) && (ref $_->{caption} eq 'ARRAY')) {
      my $c = $_->{caption};
      $x = $_->{caption}->[0] if @$c >= 1;
      $y = $_->{caption}->[1] if @$c >= 2;
  }
  $x = (splitpath($f))[2] unless $x;
  $y = $x unless $y;
  $html .= qq{\n\t  <a id="$id" href="$f" title="$y">}
         . qq{<img src="$t" alt="$x"/></a>};
  $id++;
}
$html .= qq{\n\t</div>\n};
$html .= qq{    </div>\n};
$html .= qq{    };
my $indexhtml = slurp('view/index.html');
$indexhtml =~ s@<noscript>.*?</noscript>@<noscript>$html</noscript>@s;
# include the optional social media decoration
if ($galleryTitle && $galleryDescription && $galleryUrl) {
  # default to the first image
  my $galleryImage = $adata->{data}->[0]->{img}->[0];
  $html = qq{
    <!-- for Facebook -->
    <meta property="og:title" content="$galleryTitle" />
    <meta property="og:description" content="$galleryDescription" />
    <meta property="og:type" content="article" />
    <meta property="og:image" content="${galleryUrl}/$galleryImage" />
    <meta property="og:url" content="$galleryUrl" />
    <!-- for Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="$galleryTitle" />
    <meta name="twitter:description" content="$galleryDescription" />
    <meta name="twitter:image" content="${galleryUrl}/$galleryImage" />
  };
  $indexhtml =~ s@    <!-- for Facebook -->\n(    .*\n)*@@;
  $indexhtml =~ s@  </head>@$html  </head>@;
}

# and finally, write out the new index.html and noscript.html files
my $index = 'index.html';
unlink($index);
my $fd;
open($fd, ">:encoding($ENCODING)", $index)
  || fatal "cannot write $index: $!";
print $fd $indexhtml;
if (close $fd) {
  set_file_mode($index);
  warn "Wrote new $index\n";
} else {
  fatal "Failed to write new $index: $!\n";
}
my $noscript = 'noscript.html';
open($fd, ">:encoding($ENCODING)", $noscript)
  || fatal "cannot write $noscript: $!";
for (split m{\n+}o, $indexhtml) {
  next if m{^\s*</?(no)?script\s*}o;
  print $fd $_, "\n";
}
if (close $fd) {
  set_file_mode($noscript);
  warn "Wrote new $noscript\n";
} else {
  fatal "Failed to write $noscript: $!\n";
}

print sprintf "%s version %s %s gallery in %s\n",
      $me, $VERSION, $updating ? 'updated' : 'created', $absOut;

exit 0;
